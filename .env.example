# Optional location for TapHerd's local registry. Defaults to $XDG_CONFIG_HOME/tapherd
# or ~/.config/tapherd.
# TAPHERD_STATE_DIR=

# Run up to this many device operations at once. Defaults to 3.
# TAPHERD_MAX_CONCURRENCY=3

# Set to 1 to save local action metadata under the registry directory.
# TAPHERD_ACTION_LOG=0

# Waitlist URL opened by `tapherd pro`. Defaults to https://tapherd.info/#waitlist.
# TAPHERD_WAITLIST_URL=

# Set to 1 to hide the Pro notice after devices and run.
# TAPHERD_NO_TEASE=0
